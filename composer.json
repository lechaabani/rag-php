{
    "name": "rag-php/rag-php",
    "description": "RAG-PHP — The reference Retrieval-Augmented Generation component for PHP",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.50",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RagPhp\\Core\\": "packages/core/src/",
            "RagPhp\\OpenAI\\": "packages/openai/src/",
            "RagPhp\\PgVector\\": "packages/pgvector/src/",
            "RagPhp\\Loaders\\": "packages/loaders/src/",
            "RagPhp\\Gemini\\": "packages/gemini/src/",
            "RagPhp\\Ollama\\": "packages/ollama/src/",
            "RagPhp\\Anthropic\\": "packages/anthropic/src/",
            "RagPhp\\Mistral\\": "packages/mistral/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RagPhp\\Core\\Tests\\": "packages/core/tests/",
            "RagPhp\\OpenAI\\Tests\\": "packages/openai/tests/",
            "RagPhp\\PgVector\\Tests\\": "packages/pgvector/tests/",
            "RagPhp\\Loaders\\Tests\\": "packages/loaders/tests/",
            "RagPhp\\Gemini\\Tests\\": "packages/gemini/tests/",
            "RagPhp\\Ollama\\Tests\\": "packages/ollama/tests/",
            "RagPhp\\Anthropic\\Tests\\": "packages/anthropic/tests/",
            "RagPhp\\Mistral\\Tests\\": "packages/mistral/tests/"
        }
    },
    "replace": {
        "rag-php/core": "self.version",
        "rag-php/openai": "self.version",
        "rag-php/pgvector": "self.version",
        "rag-php/loaders": "self.version",
        "rag-php/gemini": "self.version",
        "rag-php/ollama": "self.version",
        "rag-php/anthropic": "self.version",
        "rag-php/mistral": "self.version"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
