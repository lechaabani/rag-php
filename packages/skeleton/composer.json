{
    "name": "rag-php/skeleton",
    "description": "RAG-PHP Skeleton — Start a new RAG project in seconds",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "rag-php/core": "^0.1",
        "rag-php/openai": "^0.1",
        "rag-php/pgvector": "^0.1",
        "rag-php/cli": "^0.1",
        "symfony/console": "^6.4|^7.0",
        "symfony/dotenv": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "query": "php bin/rag rag:query",
        "index": "php bin/rag rag:index",
        "stats": "php bin/rag rag:stats",
        "test-connection": "php bin/rag rag:test-connection"
    }
}
