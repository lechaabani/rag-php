###> RAG-PHP Configuration ###

# LLM Provider: openai, gemini, ollama, anthropic, mistral
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini

# Embedder Provider: openai, gemini, ollama, mistral
RAG_EMBEDDER_PROVIDER=openai
RAG_EMBEDDER_MODEL=text-embedding-3-small

# API Keys (set the one matching your provider)
OPENAI_API_KEY=sk-your-openai-key-here
# GEMINI_API_KEY=your-gemini-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# MISTRAL_API_KEY=your-mistral-key-here

# Vector Store
RAG_STORE_DRIVER=pgvector
DATABASE_URL=postgresql://rag:rag_secret@localhost:5432/rag_db

# Ollama (if using local models)
# OLLAMA_BASE_URI=http://localhost:11434

###< RAG-PHP Configuration ###
