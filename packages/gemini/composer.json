{
    "name": "rag-php/gemini",
    "description": "RAG-PHP Gemini adapter — Google Gemini Embedder and LLM",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "rag-php/core": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
