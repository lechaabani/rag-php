{
    "name": "rag-php/symfony",
    "description": "RAG-PHP Symfony Bundle — Auto-wiring, YAML configuration, and DI integration",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "rag-php/core": "^0.1",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/yaml": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "RagPhp\\SymfonyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RagPhp\\SymfonyBundle\\Tests\\": "tests/"
        }
    }
}
